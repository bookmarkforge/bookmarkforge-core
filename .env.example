# Local Development Environment Variables for Vercel
# Copy this file to .env.local and fill in your values

# Build Environment
VITE_BUILD_ENV=development

# Analytics (Optional)
# VITE_SENTRY_DSN=your-sentry-dsn-here
# VITE_SENTRY_ENVIRONMENT=development

# AI Providers (Optional - for local testing)
# Note: In production, these are stored encrypted in the user's vault
# VITE_GEMINI_API_KEY=your-gemini-api-key
# VITE_OPENAI_API_KEY=your-openai-api-key
# VITE_ANTHROPIC_API_KEY=your-anthropic-api-key

# Feature Flags
VITE_ENABLE_BETA_FEATURES=false
VITE_ENABLE_DEBUG_MODE=false

# Performance
VITE_LOG_PERFORMANCE=false

# CI/CD and Monitoring (used in GitHub workflows)
# TRENDS_MIN_CONSECUTIVE_DEGRADED_MULTIUSER=3
# TRENDS_MIN_CONSECUTIVE_DEGRADED_PERF_SCALE=5
# PRODUCTION_URL=https://bookmarkforgeapp.com
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Archil workspace disk (agent-loop persistence - see scripts/archil-disk.mjs)
# Operator-only: read by the disk CLI, never inlined into the app bundle.
# ARCHIL_API_KEY=your-archil-api-key
# ARCHIL_REGION=aws-us-east-1
