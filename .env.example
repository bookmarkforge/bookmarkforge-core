# Local Development Environment Variables for Vercel
# Copy this file to .env.local and fill in your values

# Build Environment
VITE_BUILD_ENV=development

# Analytics (Optional)
# VITE_SENTRY_DSN=your-sentry-dsn-here
# VITE_SENTRY_ENVIRONMENT=development

# AI Providers (Optional - for local testing)
# Note: In production, these are stored encrypted in the user's vault
# VITE_GEMINI_API_KEY=your-gemini-api-key
# VITE_OPENAI_API_KEY=your-openai-api-key
# VITE_ANTHROPIC_API_KEY=your-anthropic-api-key

# Feature Flags
VITE_ENABLE_BETA_FEATURES=false
VITE_ENABLE_DEBUG_MODE=false

# Performance
VITE_LOG_PERFORMANCE=false
