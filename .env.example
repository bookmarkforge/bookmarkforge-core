# BookmarkForge — environment template.
#
# Copy to .env.local (dev) or .env.production (deploy) and fill in values.
# NEVER put real secrets here and never commit a real .env file.
# Full reference and defaults: docs/ENVIRONMENT.md

# ── Client bundle (VITE_*, inlined at build time by Vite) ───────────────
VITE_APP_VERSION=1.0.0
VITE_DB_NAME=bookmarkforge

# BYO AI & connectivity (all optional; the Core works offline without these)
# VITE_P2P_SIGNALING_URL=wss://signaling.example.com
# VITE_SENTRY_DSN=                      # opt-in error reporting only
# VITE_TURN_URL=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=                 # secret
# VITE_FETCH_PROXY_URL=
# VITE_MODEL_SELF_HOST_URL=             # e.g. http://localhost:11434 (Ollama)
# VITE_WHOP_CHECKOUT_URL_EARLY=
# VITE_WHOP_CHECKOUT_URL_REGULAR=

# Development/testing-only overrides — never enable these in production
# VITE_DISABLE_NETWORK_FIREWALL=false
# VITE_FORCE_MEMORY_STORAGE=false
# VITE_ALLOW_V5_LEGACY_READ=false       # legacy v5 vault migration only
# VITE_E2E_PREVIEW_DIAGNOSTICS=false
# VITE_E2E_KDF_DIAGNOSTICS=false
# VITE_TEST_BUILD=false

# ── Companion server (server/src — Pro/hosted infra) ────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=0
# Required in production: comma/space-separated origin allow-list
WS_ALLOWED_ORIGINS=

# Signaling
SIGNALING_ADMIN_TOKEN=                 # secret; admin endpoint fails closed when empty
SIGNALING_IP_HASH_SALT=                # set a unique random string in production

# TURN relay (optional)
# TURN_RELAY_HOST=
# TURN_STATIC_AUTH_SECRET=              # secret
# TURN_PORT=3478
# TURN_TLS_PORT=5349
# TURN_TTL=900

# CSP report collector
# CSP_REPORT_ADMIN_TOKEN=               # secret
# CSP_REPORT_ALLOWED_ORIGIN=
# CSP_REPORT_IP_HASH_SALT=
# CSP_REPORT_WEBHOOK_URL=               # https only (http rejected fail-closed in production)

# License signing (server-side only — never in the client bundle)
# LICENSE_SIGNING_PRIVATE_KEY_PKCS8=    # base64 PKCS#8 DER
# LICENSE_SIGNING_PRIVATE_KEY_FILE=     # path to a PEM or DER key file

# ── Client events (alert webhook) ────────────────────────────────────────
CLIENT_EVENTS_WEBHOOK_URL=             # https only in production
CLIENT_EVENTS_ADMIN_TOKEN=             # secret
CLIENT_EVENTS_IP_HASH_SALT=            # required in production (IP privacy)

# ── Ops / monitoring scripts ─────────────────────────────────────────────
DRILL_ALERT_WEBHOOK_URL=               # backup/restore drill alerts (https only)
ANALYTICS_ALERT_WEBHOOK_URL=           # KPI/analytics alerts (https only)

# ── Docker compose ────────────────────────────────────────────────────────
# IMAGE_TAG is injected per-deploy by the deploy scripts — do not pin it here.
# HTTP_PORT=8080
