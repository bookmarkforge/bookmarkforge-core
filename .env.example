# ==========================================================================
# BookmarkForge — environment variables
# ==========================================================================
# Copy this file to `.env` and adjust. VITE_* variables are inlined into
# the client bundle at build time by Vite.
#
# SECURITY: never commit real keys. The app REFUSES to boot in production
# if an AI provider key is bundled without a proxy (assertValidForBuild).
# For production AI access use VITE_*_PROXY_URL (your own server-side
# proxy) instead of shipping keys to the browser.
# ==========================================================================

# --- App identity -------------------------------------------------------
VITE_APP_VERSION=1.0.0
# Primary deployment domain. Drives the CSP report-uri endpoint and the
# self-hosted P2P signaling host (wss://signal.<domain>). Regenerate the
# CSP copies after changing it: `npm run nginx:render`.
BOOKMARKFORGE_DOMAIN=bookmarkforge.com
# VITE_BUILD_HASH=            # normally injected at build; pin only for repros

# --- Storage ------------------------------------------------------------
VITE_DB_NAME=bookmarkforge_v5

# --- Error reporting (Sentry) --------------------------------------------
# Optional. Leave EMPTY to keep error reporting strictly local (default).
# When set, redacted technical errors are sent to Sentry ONLY after the user
# opts in via the consent banner (beforeSend strips query strings, secrets
# and user identity). Setting a DSN adds its ingest host to the CSP
# connect-src at build time — regenerate the CSP copies (npm run nginx:render)
# before deploying.
VITE_SENTRY_DSN=

# Public Whop checkout URL (not a secret). Leave empty until the concrete
# product URL is configured; a generic https://whop.com/ URL is not enough.
VITE_WHOP_CHECKOUT_URL=
# VITE_FORCE_MEMORY_STORAGE=false   # NEVER enable in production (no persistence)
# VITE_FORCE_DEXIE_STORAGE=false

# --- AI providers --------------------------------------------------------
# The browser never receives provider secrets in production. Configure the
# companion server with GEMINI_API_KEY instead; it serves the same-origin
# /api/services/ai/generate proxy consumed by GeminiProvider.
# VITE_GEMINI_API_KEY=            # development-only legacy client key; never production
# VITE_GEMINI_PROXY_URL=          # optional external proxy URL; must be in CSP/firewall policy

# Companion server AI proxy (runtime env, not bundled)
# GEMINI_API_KEY=
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models
# AI_TTS_MODEL=gemini-2.5-flash-preview-tts # upstream TTS model for /generate-tts (env-overridable)
# AI_IMAGE_MODEL=imagen-3.0-generate-002    # upstream image model for /generate-image (env-overridable)
# AI_SESSION_REQUIRE_LICENSE=1    # production requires a verified signed license proof
# AI_SESSION_ORIGINS=             # comma-separated exact browser origins; same-origin is always accepted
# AI_PROXY_REDIS_FAILURE_MODE=fail-closed # fail-open is an explicit availability trade-off
# AI_PROXY_IP_RATE_LIMIT=60        # coarse per-IP requests/minute (defense-in-depth floor)
# AI_PROXY_IDENTITY_RATE_LIMIT=60  # per-authenticated-identity requests/minute
# AI_PROXY_DAILY_QUOTA=10000       # per-identity requests per UTC day (global default)
# AI_PROXY_TOKEN_QUOTAS=            # per-token daily quotas: "tokenA:100,tokenB:50" (tokens without ":" or ","; unlisted fall back to the global quota)
# AI_PROXY_TOKEN_RATE_LIMITS=      # per-token per-minute rate limits: "tokenA:10,tokenB:5" (unlisted fall back to the global identity rate limit)
# AI_PROXY_CIRCUIT_BREAKER_THRESHOLD=5      # consecutive upstream failures before opening
# AI_PROXY_CIRCUIT_BREAKER_COOLDOWN_MS=30000 # ms the breaker stays open before a half-open probe
# AI_PROXY_STATE_FILE=                       # JSON file persisting daily quotas + open breaker across restarts (atomic writes; unset = in-memory)
# AI_PROXY_REDIS_URL=                         # redis://[:password@]host:6379/0; shared durable state for multiple proxy instances (takes priority over state file)
# Redis client hardening: each command has a bounded timeout; oversized/malformed RESP replies close the connection and are retried once.
# Authenticated malformed AI requests consume the per-minute rate limit as abuse defense, but never consume daily quota.
# AI_PROXY_ADMIN_TOKEN=            # token for GET /api/services/ai/admin (per-identity diagnostic endpoint); unset = disabled (503)
# AI_PROXY_AUTH_TOKEN=             # single shared bearer token (legacy server-to-server auth; ignored when AI_SESSION_ORIGINS-based sessions are enabled)
# AI_PROXY_AUTH_TOKENS=            # comma-separated bearer tokens, each with its own quota/rate budget
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_GROQ_API_KEY=
VITE_HUGGINGFACE_API_KEY=
# Route ALL external fetches through your own proxy (keys/prompts never
# leave your infrastructure). Original target goes in X-Target-Url.
VITE_FETCH_PROXY_URL=
# Self-hosted model endpoint (WebLLM / Ollama-style).
VITE_MODEL_SELF_HOST_URL=

# --- P2P sync / signaling ------------------------------------------------
# Self-hosted signaling server URL (see server/src/index.ts). Leave unset
# until your signaling host exists; it defaults to wss://signal.<BOOKMARKFORGE_DOMAIN>.
# VITE_P2P_SIGNALING_URL=wss://signal.bookmarkforge.com
# TURN relay credentials (only needed when NAT traversal fails). Prefer the
# server-side TURN_REST secret; these are the static fallback.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# --- Security / test toggles (dev-only; production guards them) ----------
# VITE_DISABLE_NETWORK_FIREWALL=false   # NEVER in production
# VITE_ENV_BOOT_STRICT=0                # throw on unset optional vars
# VITE_ENV_PREFIX_STRICT=0              # warn on non-VITE_ operator vars
# VITE_TEST_BUILD=false                 # NEVER in production
# VITE_DEV_MODE=

# --- E2E human-like behavior (tests/e2e, Playwright runner env) -----------
# Wraps the AdvancedHumanBehavior simulator so vault / quick-capture E2E
# flows move and type like a human locally while staying deterministic in
# CI (read by the Playwright process, see tests/e2e/human-behavior.ts).
# E2E_HUMAN_LIKE=1              # force ON; unset => ON locally, OFF in CI
# E2E_HUMAN_BASE_DELAY=60       # base delay between actions (ms)
# E2E_HUMAN_DELAY_VARIATION=40  # random spread around the base (ms)
# E2E_HUMAN_MOUSE_SPEED=normal  # slow | normal | fast
# E2E_HUMAN_MISTAKES=0          # 1 to simulate typos (keep 0 for vault)
# E2E_HUMAN_FATIGUE=0           # 1 to slow down over time
# E2E_HUMAN_HESITATION=1        # 0 to disable pre-action pauses
# E2E_HUMAN_JITTER=1            # 0 to disable mouse jitter
# E2E_HUMAN_SCROLLING=1         # 0 to disable natural scrolling

# ==========================================================================
# Signaling server (server/src/index.ts) — runtime env, not bundled.
# ==========================================================================
# PORT=8787
# HOST=0.0.0.0
# MAX_CONNECTIONS=512
# MAX_ROOMS=2048
# MAX_PEERS_PER_ROOM=64
# MAX_PAYLOAD_BYTES=1048576
# JOIN_LIMIT=120
# JOIN_WINDOW_MS=60000
# TRUST_PROXY=0                  # set to 1 behind nginx/caddy
# ENFORCE_SIGNAL_HMAC=1          # HMAC-signature requirement on signals
# TURN_RELAY_HOST=               # coturn host (mints REST credentials)
# TURN_STATIC_AUTH_SECRET=       # coturn use-auth-secret
# TURN_PORT=3478
# TURN_TLS_PORT=5349
# TURN_TTL=900             # coturn REST credential TTL in seconds (clamped to 300–3600; default 900 = 15 min)

# CSP violation collector (POST /csp-report; runtime env, not bundled)
# CSP_REPORT_MAX=200              # in-memory ring of recent reports
# CSP_REPORT_LIMIT=30             # reports per IP per window
# CSP_REPORT_WINDOW_MS=60000
# CSP_REPORT_FILE=                # optional JSONL persistence (stateless by default)
# CSP_REPORT_ADMIN_TOKEN=         # token for the GET diagnostics dashboard (unset = disabled)
# CSP_REPORT_ALLOWED_ORIGIN=      # comma-separated CORS origins for the collector
# CSP_REPORT_BODY_MAX_BYTES=16384
# CSP_REPORT_RATE_MAX_ENTRIES=10000
# CSP_REPORT_WEBHOOK_URL=          # optional alerting webhook (batched, redacted payloads; HTTPS only)
# CSP_REPORT_WEBHOOK_ALLOW_HTTP=0   # 1 = permit http:// (non-production only; explicit opt-out)
# CSP_REPORT_WEBHOOK_INTERVAL_MS=15000
# CSP_REPORT_WEBHOOK_BATCH_MAX=20
# CSP_REPORT_WEBHOOK_MAX_ATTEMPTS=3
# CSP_REPORT_WEBHOOK_QUEUE_MAX=1000  # hard cap on undelivered reports (oldest dropped)
# CSP_REPORT_WEBHOOK_TIMEOUT_MS=5000

# Business analytics (opt-in, aggregated, non-PII) — companion server
# Clients send ONE daily aggregated bucket per install ONLY after the user
# opts in (forge_consent_analytics). No vault content, no raw install ids
# (only a SHA-256 hash), no IPs stored. GET /api/analytics/kpis is fail-closed.
# ANALYTICS_ADMIN_TOKEN=       # token for GET /api/analytics/kpis (unset = disabled)
# ANALYTICS_RATE_LIMIT=60      # per-IP buckets per window
# ANALYTICS_WINDOW_MS=600000
# ANALYTICS_MAX_INSTALLS=200000
# ANALYTICS_RATE_MAX_ENTRIES=10000
# ANALYTICS_BODY_MAX_BYTES=16384
# ANALYTICS_STATE_FILE=        # optional JSON persistence (atomic writes; unset = in-memory)
# ANALYTICS_MAX_DAYS=180       # retained day history
# ANALYTICS_IP_HASH_SALT=      # salt for the per-IP one-way hash (default: server instance id)
#
# KPI gate nocturno (scripts/kpi-report.mjs — job kpi-staging en nightly.yml):
# umbrales opcionales; por debajo el job falla (página) y dispara el webhook.
# KPI_MIN_DAU=               # DAU mínimo (entero >= 0)
# KPI_MIN_WAU=               # WAU mínimo
# KPI_MIN_MAU=               # MAU mínimo
# KPI_MIN_D7_PCT=            # retención D7 mínima (0..1) de la cohorte >= 7 días
# KPI_MIN_D30_PCT=           # retención D30 mínima (0..1) de la cohorte >= 30 días
# ANALYTICS_ALERT_WEBHOOK_URL=  # webhook HTTPS (p. ej. Slack); http rechazado

# Companion server license signing / Whop adapter (runtime env, not bundled)
# LICENSE_SIGNING_PRIVATE_KEY_PKCS8=      # base64 PKCS#8 DER; required to sign entitlements
# LICENSE_SIGNING_PRIVATE_KEY_FILE=       # alternative PEM/DER file path
# WHOP_LICENSE_API_URL=https://your-whop-adapter.example.com/license
# WHOP_API_KEY=                            # server-only credential
# LICENSE_PROVIDER_ALLOW_HTTP=0            # staging mocks only; ignored in production
