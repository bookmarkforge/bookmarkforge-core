# ==========================================================================
# BookmarkForge — producción/staging environment variables (plantilla)
# ==========================================================================
# Copia este archivo a `.env.production` y ajusta. VITE_* variables son
# inlined al bundle por Vite en tiempo de build.
#
# SECURITY: never commit real keys. AI provider keys se almacenan
# cifradas en el vault del usuario (securityVault) en runtime.
# ==========================================================================

# --- App identity -------------------------------------------------------
VITE_APP_VERSION=
VITE_DB_NAME=
BOOKMARKFORGE_DOMAIN=bookmarkforge.com

# --- AI providers --------------------------------------------------------
# Provider keys are stored encrypted in the user's vault and used directly
# from the browser. The server no longer proxies AI calls.
VITE_FETCH_PROXY_URL=
VITE_MODEL_SELF_HOST_URL=

# --- P2P sync / signaling ------------------------------------------------
VITE_P2P_SIGNALING_URL=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# --- Companion server (runtime env, not bundled) -------------------------
AI_SESSION_ORIGINS=
WHOP_LICENSE_API_URL=
WHOP_API_KEY=
LICENSE_SIGNING_PRIVATE_KEY_FILE=
LICENSE_SIGNING_KEY_FILE=
ENFORCE_SIGNAL_HMAC=1
HTTP_PORT=8080
PORT=8787
TRUST_PROXY=1
HOST=0.0.0.0

# --- Security / test toggles (dev-only; production guards them) --------
VITE_DISABLE_NETWORK_FIREWALL=false
VITE_ENV_BOOT_STRICT=0
VITE_ENV_PREFIX_STRICT=0
VITE_TEST_BUILD=false
VITE_DEV_MODE=

# CSP violation collector (POST /csp-report; runtime env, not bundled)
CSP_REPORT_ADMIN_TOKEN=

# Business analytics (opt-in, aggregated, non-PII)
ANALYTICS_ADMIN_TOKEN=

# Penetration test / CI runtime vars
PRODUCTION_URL=
SLACK_WEBHOOK_URL=
