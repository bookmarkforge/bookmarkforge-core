# ==========================================================================
# BookmarkForge — Producción/Staging Environment Variables
# ==========================================================================
# Copia este archivo a `.env.production` y rellena cada valor.
# VITE_* variables se inyectan al bundle por Vite en tiempo de build.
# NO variables VITE_* con secretos (la clave privada del servidor NO es VITE_*).
#
# SECURITY: Nunca commits este archivo con valores reales.
# Provider keys se almacenan cifradas en el vault del usuario.
# La clave de firma de licencias es SECRETA — va en GitHub Secrets.
# ==========================================================================

# --- App Identity -------------------------------------------------------
# Versión de la app (debe coincidir con package.json)
VITE_APP_VERSION=1.0.0
# Nombre de la base de datos IndexedDB (cambiar para evitar conflicts)
VITE_DB_NAME=bookmarkforge_prod
# Dominio principal de BookmarkForge
BOOKMARKFORGE_DOMAIN=bookmarkforgeapp.com

# --- AI Providers -------------------------------------------------------
# Provider keys se almacenan cifradas en el vault del usuario (securityVault).
# El servidor NO proxya llamadas AI — el navegador llama directamente al proveedor.
# Estas son URLs de fallback para modelos auto-hospedados (opcional).
VITE_FETCH_PROXY_URL=
VITE_MODEL_SELF_HOST_URL=

# --- P2P Sync / Signaling -----------------------------------------------
# URL del servidor de señalización WebRTC
VITE_P2P_SIGNALING_URL=wss://signal.bookmarkforgeapp.com
# URL del servidor TURN (relay WebRTC, opcional)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# --- Companion Server (runtime env, NOT bundled) -------------------------
# Orígenes permitidos para POST /api/license/entitlement
# Debe ser EXACTAMENTE el dominio de producción
AI_SESSION_ORIGINS=https://bookmarkforgeapp.com
# URL de la API de licencias de Whop
WHOP_LICENSE_API_URL=https://api.whop.com
# API Key de Whop (server-side ONLY — nunca en VITE_*)
WHOP_API_KEY=
# Ruta al archivo de clave privada de firma de licencias
# El archivo se monta como Docker secret en producción
LICENSE_SIGNING_PRIVATE_KEY_FILE=/run/secrets/license_signing_key
LICENSE_SIGNING_KEY_FILE=/run/secrets/license_signing_key
# HMAC obligatorio para señalización (producción: siempre 1)
ENFORCE_SIGNAL_HMAC=1
# Puerto del servidor HTTP
HTTP_PORT=8080
# Puerto del WebSocket server
PORT=8787
# Trust X-Forwarded-For (1=si, debe ser 1 si hay reverse proxy delante)
TRUST_PROXY=1
# Host binding (0.0.0.0 = escucha en todas las interfaces)
HOST=0.0.0.0

# --- Security / Production Hardening ------------------------------------
# CSP Report Admin Token (para acceder a /admin endpoint de CSP reports)
CSP_REPORT_ADMIN_TOKEN=
# Token admin para el endpoint de diagnóstico del servidor de señalización
SIGNALING_ADMIN_TOKEN=
# Salt para hasheado de IPs de señalización
SIGNALING_IP_HASH_SALT=
# Token admin para el endpoint de client events
CLIENT_EVENTS_ADMIN_TOKEN=
# Webhook para alertas de client events (>= 3 clients en 10 min)
CLIENT_EVENTS_WEBHOOK_URL=
# Webhook para CSP reports (HTTPS only)
CSP_REPORT_WEBHOOK_URL=

# --- Business Analytics (opt-in, aggregated, non-PII) ------------------
# Token admin para el dashboard de analytics
ANALYTICS_ADMIN_TOKEN=
# Webhook para alertas cuando KPIs caen por debajo del umbral
ANALYTICS_ALERT_WEBHOOK_URL=
# Umbrales mínimos de KPIs
KPI_MIN_DAU=
KPI_MIN_WAU=
KPI_MIN_MAU=
KPI_MIN_D7_PCT=
KPI_MIN_D30_PCT=

# --- Whop Checkout ------------------------------------------------------
# URL del checkout de Whop para la compra de licencias Pro
VITE_WHOP_CHECKOUT_URL=https://bookmarkforgeapp.com/checkout

# --- Penetration Test / CI Runtime --------------------------------------
# URL de producción para health checks y smoke tests
PRODUCTION_URL=https://bookmarkforgeapp.com
# Webhook de Slack para alertas de operaciones
SLACK_WEBHOOK_URL=

# --- Staging (solo si desplegas staging) --------------------------------
# URL del entorno de staging
STAGING_URL=https://staging.bookmarkforgeapp.com
# Token de smoke test para staging
STAGING_SMOKE_TOKEN=
STAGING_SMOKE_ADMIN_TOKEN=
# Token de analytics para staging
STAGING_ANALYTICS_ADMIN_TOKEN=

# --- Docker Registry ----------------------------------------------------
# Registro para push de imágenes (si usas --push-images)
DOCKER_REGISTRY=
DOCKER_REGISTRY_PASSWORD=

# --- Sentry (opt-in, error reporting) -----------------------------------
# DSN de Sentry para reporte de errores (el usuario debe opt-in)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# --- Testing (no usar en producción) ------------------------------------
# Desactivar en producción: estos son para desarrollo/testing only
VITE_DISABLE_NETWORK_FIREWALL=false
VITE_ENV_BOOT_STRICT=0
VITE_ENV_PREFIX_STRICT=0
VITE_TEST_BUILD=false
VITE_DEV_MODE=

# ==========================================================================
# ⚠️ IMPORTANTE — NO DEBES PONER ESTO EN VITE_*:
# ==========================================================================
# - LICENSE_SIGNING_PRIVATE_KEY (va en /run/secrets/ como file mount)
# - WHOP_API_KEY (va como variable de entorno del servidor, NO bundled)
# - Cualquier contraseña, API key de usuario, o secret criptográfico
# ==========================================================================
# VITE_* se inyecta en el bundle del navegador — lo que está en VITE_*
# es visible en el código fuente del frontend.
# ==========================================================================
