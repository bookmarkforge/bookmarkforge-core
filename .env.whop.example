# Whop.com Configuration
# Copy this file to .env and fill in your values

# Whop Account API Key (Server-side only - never expose to client)
# Get this from: Whop Dashboard → Developer → API Keys → Account API Keys
WHOP_API_KEY=your_whop_account_api_key_here

# Whop Product ID for BookmarkForge Pro
# Get this from: Whop Dashboard → Products → BookmarkForge Pro
WHOP_PRODUCT_ID=prod_xxxxxxxxxxxxxx

# Whop Plan ID for BookmarkForge Pro LIFETIME
# Get this from: Whop Dashboard → Products → BookmarkForge Pro → Plans
# Select the "Lifetime" plan type (one-time purchase)
WHOP_PLAN_LIFETIME=plan_xxxxxxxxxxxxxx

# Whop Trial Duration (days) — the number of days a new user gets Pro features for free before being downgraded
# Set this to 7 for a 7-day free trial
WHOP_TRIAL_DURATION_DAYS=7

# Whop Trial Price — what the user pays for the trial (0 = free trial)
WHOP_TRIAL_PRICE=0

# Whop Webhook Secret (for webhook verification)
# Get this from: Whop Dashboard → Developer → Webhooks
WHOP_WEBHOOK_SECRET=your_webhook_secret_here

# Environment
WHOP_ENVIRONMENT=development