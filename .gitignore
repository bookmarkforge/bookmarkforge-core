# Environment and secrets
.env
.env.*
!.env.example
!.env.production.example
!.env.whop.example
*.pem
*.key
*.crt
server/.license-signing-key.pkcs8

# Dependencies and build output
node_modules/

# Build/entrega: no son fuente del proyecto
dist/
dist-extension/
coverage/
playwright-report/
playwright-report-*/
test-results/
test-results-*/
test-results-performance/
.vite/
# Caché incremental de TypeScript (tsconfig.json declara "incremental": true):
# `npm run typecheck` la reescribe en cada ejecución y no es fuente.
*.tsbuildinfo

# Playwright generated comparison/artifact dirs (never versioned)
tests/e2e/__diffs__/
tests/e2e/__snapshots__/

# Local runtime state
.freebuff/
*.log
*.jsonl
.monitor-state.json
.api-degradation-history.json
ci-chunk-report.json

# Generated diagnostic artifacts (regenerated by build/coverage runs)
bundle-report.md
performance-budget-report.json
coverage-history.json
# `npm run cve:report` output (the gate itself needs no artifact)
dependency-cve-report.md
dependency-cve-report.json
# The nightly weekly report publishes both audit profiles under their own names.
dependency-cve-report-prod.md
dependency-cve-report-prod.json
dependency-cve-report-dev.md
dependency-cve-report-dev.json

# Generated print twins of the localized user manuals. `npm run
# docs:pdf:localized` writes docs/manual-usuario-*-styled.html as the
# intermediate the PDF renderer consumes; only the .md sources and the .pdf
# deliverables are versioned.
docs/*-styled.html

# Generated nightly reports (created by CI jobs, never source)
nightly-trends.csv
nightly-trends-summary.csv
nightly-trends-summary.md
nightly-trends.svg
nightly-consistency.csv
nightly-consistency.json
nightly-consistency.svg
scripts/__tmp-sw-debug.mjs

# Temp artifacts from automated code review / merge tooling (never source)
.tmp/
*.tmp-*
.merge_file_*

# Local scratch / experiments (never source)
.d/
.d/tmp/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Drill/session evidence (personal captures — never source, never export)
evidence/

# Private legal and provider-contract workspace: excluded from the public
# export and unversioned by default. The legal material the ADR-060 gate
# requires in CI (legal/README.md, legal/REGISTRO.md, legal/plantillas/*.md)
# is force-added deliberately — signed contracts and provider evidence are not.
legal/

# CLS measurement artifact from tests/e2e/dashboard-banner-cls.spec.ts (BMF_CLS_REPORT)
docs/cls-report.json

.vercel
.env*
