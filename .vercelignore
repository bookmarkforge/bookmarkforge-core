# Vercel ignore file
# Files to exclude from the Vercel deployment upload.
#
# CRITICAL: this file filters the source uploaded for CLI deploys
# (`vercel` / `vercel deploy --prod`). It must NEVER be a whitelist of the
# source tree (`*` + `!vercel.json`): Vercel would upload only `vercel.json`,
# the build container would have no `package.json`, and the deploy dies with
#     npm error enoent Could not read package.json: .../vercel/path0/package.json
#     Error: Command "npm run build" exited with 254
# Automatic Git deployments are disabled in the Vercel dashboard and via
# `git.deploymentEnabled` in vercel.json — NOT with this file (see
# DEPLOY-POLICY.md).
#
# Note: when `.vercelignore` exists it REPLACES `.gitignore` as the upload
# filter, so the build-irrelevant entries of `.gitignore` must be replicated
# here (dependencies, build output, caches, private workspaces).

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output (the deploy builds it from source)
dist/
dist-extension/
.vite/

# Testing and coverage
coverage/
.nyc_output/
test-results/
test-results-*/
playwright-report/
playwright-report-*/
playwright/.cache/
tests/e2e/__diffs__/
tests/e2e/__snapshots__/

# Environment files (never ship real secrets; examples are fine)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.crt

# Logs and local runtime state
logs/
*.log
*.jsonl
.monitor-state.json
.api-degradation-history.json
ci-chunk-report.json

# Generated diagnostic artifacts (regenerated by build/coverage runs)
bundle-report.md
performance-budget-report.json
coverage-history.json
dependency-cve-report*.md
dependency-cve-report*.json
nightly-trends.csv
nightly-trends-summary.csv
nightly-trends-summary.md
nightly-trends.svg
nightly-consistency.csv
nightly-consistency.json
nightly-consistency.svg
docs/*-styled.html
docs/cls-report.json
scripts/__tmp-sw-debug.mjs

# Caches
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo
.tmp/
*.tmp-*
.merge_file_*
.d/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Private legal and provider-contract workspace: excluded from the public
# export and unversioned by default — do not upload it to a CDN either.
evidence/
legal/

# Vercel CLI local state
.vercel/
