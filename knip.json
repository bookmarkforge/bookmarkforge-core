{
  "$schema": "https://raw.githubusercontent.com/webpro/knip/main/schema.json",
  "entry": [
    "src/App.tsx",
    "app.html",
    "src/index.css",
    "scripts/**/*.{mjs,cjs,js}",
    "src/modules/translation/index.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}"
  ],
  "ignore": [
    "src/tests/**"
  ],
  "ignoreDependencies": [
    "buffer",
    "@mlc-ai/web-llm",
    "pdfjs-dist",
    "undici"
  ],
  "ignoreUnresolved": [
    "server/src/route-table.*"
  ],
  "ignoreIssues": {
    "src/services/ai/SemanticCacheService.ts": [
      "exports"
    ],
    "src/services/ai/TaggingService.ts": [
      "exports"
    ],
    "src/services/ai/utils.ts": [
      "exports"
    ],
    "src/services/ai/WebSearchService.ts": [
      "exports",
      "types"
    ],
    "src/services/integrations/cloudSync.adapters.s3.ts": [
      "exports"
    ],
    "src/utils/download.ts": [
      "exports"
    ],
    "src/modules/translation/types.ts": [
      "types"
    ]
  },
  "ignoreBinaries": [
    "vercel",
    "netstat"
  ],
  "rules": {
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "enumMembers": "error",
    "dependencies": "error",
    "files": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "off"
  }
}
