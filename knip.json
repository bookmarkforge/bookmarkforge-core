{
  "$schema": "https://raw.githubusercontent.com/webpro/knip/main/schema.json",
  "entry": [
    "src/App.tsx",
    "app.html",
    "src/index.css",
    "scripts/**/*.{mjs,cjs,js}",
    "src/modules/translation/index.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "api/**/*.ts"],
  "ignore": ["**/*.spec.{ts,tsx}", "src/tests/**"],
  "ignoreDependencies": ["lint-staged", "buffer"],
  "ignoreBinaries": [
    "vercel",
    "netstat"
  ],
  "rules": {
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "enumMembers": "error",
    "dependencies": "error",
    "files": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "off"
  }
}
