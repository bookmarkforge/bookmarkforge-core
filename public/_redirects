# SPA Routing — client-side routes are served by index.html.

# Landing pages (SEO) — the static marketing HTML is the indexable
# content, served at clean URLs with a 200 rewrite so the canonical
# stays https://bookmarkforge.com/ and /es/. Must precede the SPA
# catch-all below.
/       /landing.html  200
/es     /es.html       200
/es/    /es.html       200
/fr     /fr.html       200
/fr/    /fr.html       200
/de     /de.html       200
/de/    /de.html       200
/pt     /pt.html       200
/pt/    /pt.html       200
/it     /it.html       200
/it/    /it.html       200

# Pocket comparison page (SEO)
/pocket-alternative  /pocket-alternative.html  200

# Legacy markdown privacy policy -> HTML
/privacy-and-terms.md  /privacy-and-terms.html  301

# Legal pages — serve the static HTML directly before SPA catch-all
/privacy  /privacy-and-terms.html  200
/terms    /privacy-and-terms.html  200

# App entry (PWA start_url / share_target point here)
/app  /index.html  200

# App routes (SPA fallback)
/*
  !/index.html
  !/*.js
  !/*.css
  !/*.ico
  !/*.png
  !/*.svg
  !/*.json
  !/*.woff2
  !/*.woff
  !/*.ttf
  !/*.eot
  !/*.webp
  !/*.avif
  !/*.webmanifest
  !/*.xml
  !/*.txt
  !/*.html
  !/*.bmf
  /index.html 200
