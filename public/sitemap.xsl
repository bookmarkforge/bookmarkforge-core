<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
                xmlns:sitemap="http://www.sitemaps.org/schemas/sitemap/0.9"
                xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <xsl:output method="html" indent="yes"/>
  <xsl:template match="/">
    <html>
      <head>
        <title>BookmarkForge Sitemap</title>
        <style>
          body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background: #f5f5f5;
          }
          h1 {
            color: #00aeef;
            border-bottom: 2px solid #00aeef;
            padding-bottom: 10px;
          }
          table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border-radius: 8px;
            overflow: hidden;
          }
          th {
            background: #00aeef;
            color: white;
            padding: 12px;
            text-align: left;
            font-weight: 600;
          }
          td {
            padding: 12px;
            border-bottom: 1px solid #e0e0e0;
          }
          tr:hover {
            background: #f9f9f9;
          }
          tr:last-child td {
            border-bottom: none;
          }
          .priority-high { color: #00c853; font-weight: bold; }
          .priority-medium { color: #ff9800; }
          .priority-low { color: #ff5722; }
          .url {
            color: #00aeef;
            text-decoration: none;
          }
          .url:hover {
            text-decoration: underline;
          }
          .lastmod {
            color: #666;
            font-size: 0.9em;
          }
          .stats {
            background: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
          }
          .stats-item {
            display: inline-block;
            margin-right: 30px;
          }
          .stats-label {
            font-weight: 600;
            color: #333;
          }
          .stats-value {
            color: #00aeef;
            font-size: 1.2em;
          }
        </style>
      </head>
      <body>
        <h1>🗺️ BookmarkForge Sitemap</h1>
        
        <div class="stats">
          <div class="stats-item">
            <span class="stats-label">Total URLs:</span>
            <span class="stats-value"><xsl:value-of select="count(//sitemap:url)"/></span>
          </div>
          <div class="stats-item">
            <span class="stats-label">Languages:</span>
            <span class="stats-value">30</span>
          </div>
          <div class="stats-item">
            <span class="stats-label">Last Updated:</span>
            <span class="stats-value"><xsl:value-of select="//sitemap:url[1]/sitemap:lastmod"/></span>
          </div>
        </div>
        
        <table>
          <thead>
            <tr>
              <th>URL</th>
              <th>Last Modified</th>
              <th>Change Frequency</th>
              <th>Priority</th>
            </tr>
          </thead>
          <tbody>
            <xsl:for-each select="//sitemap:url">
              <tr>
                <td>
                  <a class="url" target="_blank">
                    <xsl:attribute name="href">
                      <xsl:value-of select="sitemap:loc"/>
                    </xsl:attribute>
                    <xsl:value-of select="sitemap:loc"/>
                  </a>
                </td>
                <td class="lastmod">
                  <xsl:value-of select="sitemap:lastmod"/>
                </td>
                <td>
                  <xsl:value-of select="sitemap:changefreq"/>
                </td>
                <td>
                  <xsl:attribute name="class">
                    <xsl:choose>
                      <xsl:when test="sitemap:priority &gt;= 0.8">priority-high</xsl:when>
                      <xsl:when test="sitemap:priority &gt;= 0.5">priority-medium</xsl:when>
                      <xsl:otherwise>priority-low</xsl:otherwise>
                    </xsl:choose>
                  </xsl:attribute>
                  <xsl:value-of select="sitemap:priority"/>
                </td>
              </tr>
            </xsl:for-each>
          </tbody>
        </table>
        
        <p style="margin-top: 20px; color: #666; font-size: 0.9em;">
          This sitemap is automatically generated by <code>scripts/generate-sitemap.mjs</code>
        </p>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
