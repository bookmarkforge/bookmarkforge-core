{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "rules": [
            { "id": "javascript.lang.security.audit.detect-eval-with-expression" }
          ]
        }
      },
      "results": [
        {
          "ruleId": "javascript.lang.security.audit.detect-eval-with-expression",
          "level": "warning",
          "message": { "text": "Found expression in eval." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/utils/helpers.ts" },
                "region": { "startLine": 10 }
              }
            }
          ]
        }
      ]
    }
  ]
}
