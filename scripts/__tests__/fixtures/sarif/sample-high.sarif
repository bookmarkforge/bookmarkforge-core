{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "test-tool",
          "version": "1.0.0"
        }
      },
      "results": [
        {
          "ruleId": "js/command-line-injection",
          "level": "error",
          "message": {
            "text": "Command injection vulnerability"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/test.js"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
