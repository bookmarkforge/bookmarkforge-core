# GitHub Branch Protection Script Environment Variables
# Copy this file to .env.local and fill in your values

# Your GitHub Personal Access Token
# Get it from: https://github.com/settings/tokens
# Required permissions: repo (full control)
GITHUB_TOKEN=your_github_token_here

# Repository owner (default: bookmarkforge)
GITHUB_REPO_OWNER=bookmarkforge

# Repository name (default: bookmarkforge)
GITHUB_REPO_NAME=bookmarkforge

# Branch to protect (default: release/v1.0.0)
BRANCH_NAME=release/v1.0.0

# Require pull request before merging (default: false)
# Set to true if you want to require PR approval
REQUIRE_PR=false

# Require status checks before merging (default: false)
# Set to true if you want to require CI/CD checks to pass
REQUIRE_STATUS_CHECKS=false
