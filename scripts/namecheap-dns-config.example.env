# Namecheap DNS Configuration Script Environment Variables
# Copy this file to .env.local and fill in your values

# Your Namecheap username
NAMECHEAP_USER=your_namecheap_username_here

# Your Namecheap API key
# Get it from: https://ap.www.namecheap.com/grant/api-key
NAMECHEAP_API_KEY=your_namecheap_api_key_here

# Domain to configure (optional, defaults to bookmarkforgeapp.com)
DOMAIN=bookmarkforgeapp.com

# Subdomain to configure (optional, defaults to www)
SUBDOMAIN=www
