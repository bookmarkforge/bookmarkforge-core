<!DOCTYPE html>
<html lang="{{ t.lang }}"
  dir="{{ t.dir }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#00aeef" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)">
  <meta name="description" content="{{ t.description }}">
  <title>{{ t.title }}</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <!-- SEO: canonical + hreflang -->
  <link rel="canonical" href="{{ t.canonical }}">
  {% for link in hreflangLinks %}
  <link rel="alternate" hreflang="{{ link.hreflang }}" href="{{ link.href }}">
  {% endfor %}
  <!-- Open Graph (og-image.png is 1200x630) -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="BookmarkForge">
  <meta property="og:title" content="{{ t.ogTitle }}">
  <meta property="og:description" content="{{ t.ogDescription }}">
  <meta property="og:url" content="{{ t.canonical }}">
  <meta property="og:image" content="{{ t.ogImage }}">
  <meta property="og:image:alt" content="{{ t.ogImageAlt }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="{{ t.ogLocale }}">
  <meta property="og:locale:alternate" content="{{ t.ogLocaleAlternate }}">
  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ t.twitterTitle }}">
  <meta name="twitter:description" content="{{ t.twitterDescription }}">
  <meta name="twitter:image" content="{{ t.twitterImage }}">
  <script src="/theme-init.js"></script>
  <link rel="stylesheet" href="/brand-tokens.css">
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/landing.css">
  <!-- Structured data (GEO): WebSite / Organization / SoftwareApplication / FAQPage.
       The permanent offer deliberately carries NO priceValidUntil: the lifetime
       licence does not expire, and an expiry date would let crawlers and AI
       answer engines retire a live offer. -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ t.canonical }}#website",
        "url": "{{ t.canonical }}",
        "name": "{{ t.structuredData.websiteName | escapejs }}",
        "description": "{{ t.structuredData.websiteDescription | escapejs }}",
        "inLanguage": "{{ t.lang }}",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "{{ t.canonical }}?s={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        },
        "publisher": { "@id": "https://www.bookmarkforgeapp.com/#organization" }
      },
      {
        "@type": "Organization",
        "@id": "https://www.bookmarkforgeapp.com/#organization",
        "name": "{{ t.structuredData.organizationName | escapejs }}",
        "url": "{{ t.structuredData.organizationUrl }}",
        "logo": { "@type": "ImageObject", "url": "https://www.bookmarkforgeapp.com/logo.png", "width": 64, "height": 64 },
        "email": "{{ t.structuredData.organizationEmail }}"
      },
      {
        "@type": "SoftwareApplication",
        "@id": "{{ t.canonical }}#software",
        "name": "BookmarkForge",
        "applicationCategory": "ProductivityApplication",
        "operatingSystem": "Windows, macOS, Linux, Browser (PWA)",
        "url": "{{ t.canonical }}",
        "image": "{{ t.ogImage }}",
        "inLanguage": "{{ t.lang }}",
        "description": "A local-first, privacy-preserving, encrypted knowledge and bookmark manager powered by local AI.",
        "offers": {
          "@type": "Offer",
          "price": "59.00",
          "priceCurrency": "USD",
          "valueAddedTaxIncluded": "false"
        },
        "featureList": [
          {% for feature in t.structuredData.featureList %}
          "{{ feature | escapejs }}"{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      },
      {
        "@type": "FAQPage",
        "@id": "{{ t.canonical }}#faq",
        "mainEntity": [
          {% for faq in t.faq.items %}
          {
            "@type": "Question",
            "name": "{{ faq.question | escapejs }}",
            "acceptedAnswer": { "@type": "Answer", "text": "{{ faq.answer | escapejs }}" }
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }
    ]
  }
  </script>
</head>
<body>
  <a href="#main" class="skip-link">{{ t.skipLink }}</a>

  <header class="nav" role="banner">
    <div class="nav-inner">
      <a href="{{ t.homeHref }}" class="nav-brand" aria-label="{{ t.navBrandAria }}">
        <img src="/logo-64.png" width="32" height="32" alt="BookmarkForge logo" />
        <span>BookmarkForge</span>
      </a>

      <nav class="nav-links" id="navLinks" aria-label="{{ t.navAriaLabel }}">
        <a href="#{{ t.pocketAlternative.id }}">{{ t.pocketAlternative.tag }}</a>
        <a href="#{{ t.raindropCompare.id }}">{{ t.navLinks.raindropCompare }}</a>
        <a href="#{{ t.features.id }}">{{ t.navLinks.features }}</a>
        <a href="#{{ t.ai.id }}">{{ t.navLinks.ai }}</a>
        <a href="#{{ t.privacy.id }}">{{ t.navLinks.privacy }}</a>
        <a href="#{{ t.pricing.id }}">{{ t.navLinks.pricing }}</a>
        <a href="{% if t.lang == 'en' %}/help{% else %}/help-{{ t.lang }}{% endif %}">{{ t.navLinks.help | default('Help') }}</a>
        <a href="mailto:bookmarkforge@proton.me">{{ t.footer.support.links[0] }}</a>

        <!-- Language Dropdown -->
        <div class="language-dropdown">
          <button class="language-toggle" aria-label="{{ t.languageToggleAria }}" aria-expanded="false">
            <span class="current-lang">{{ t.langName }}</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 4 L6 8 L10 4"/>
            </svg>
          </button>
          <ul class="language-menu" role="menu" aria-hidden="true">
            {% for lang in languageLinks %}
            <li role="none">
              <a href="{{ lang.href }}" hreflang="{{ lang.hreflang }}" lang="{{ lang.lang }}" role="menuitem"{% if lang.code == t.lang %} class="current"{% endif %}>
                {{ lang.name }}
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>
        
        <a href="/app" class="btn-primary nav-cta">{{ t.navCta }}</a>
      </nav>

      <div class="nav-actions">
        <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navLinks" aria-label="{{ t.navToggleAria }}" data-label-close="{{ t.navToggleAriaClose }}">
          <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18"/><path d="M3 12h18"/><path d="M3 18h18"/></svg>
          <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
        <button class="theme-toggle" id="themeToggle" aria-label="{{ t.themeToggleAria }}" aria-pressed="false">
          <svg class="theme-icon-light" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          <svg class="theme-icon-dark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container">
        <div class="hero-content">
          {% if t.hero.announceApps %}<div class="announce-bar">{{ t.hero.announceApps }}</div>{% endif %}
          {% if t.hero.announce %}<div class="announce-bar">{{ t.hero.announce }}</div>{% endif %}
          {% if t.hero.badge %}<span class="hero-badge">{{ t.hero.badge }}</span>{% endif %}
          <h1 id="hero-title">{{ t.hero.title | safe }}</h1>
          <p class="hero-subtitle">{{ t.hero.subtitle }}</p>
          <div class="hero-ctas">
            <a href="/app" class="btn-primary">{{ t.hero.ctaPrimary }}</a>
            <a href="#{{ t.features.id }}" class="btn-secondary">{{ t.hero.ctaSecondary }}</a>
          </div>
          <div class="hero-pillars">
            {% for pillar in t.hero.pillars %}
            <span><strong>{{ pillar.strong }}</strong> — {{ pillar.text }}</span>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- Before/After Section -->
    <section id="{{ t.beforeAfter.id }}" class="comparison-section" aria-labelledby="{{ t.beforeAfter.id }}-title">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">{{ t.beforeAfter.tag }}</span>
          <h2 id="{{ t.beforeAfter.id }}-title">{{ t.beforeAfter.title }}</h2>
          <p class="section-subtitle">{{ t.beforeAfter.subtitle }}</p>
        </div>
        <div class="features-grid-2">
          <div class="feat-card feat-card-before">
            <h3>{{ t.beforeAfter.before.title }}</h3>
            <ul class="feat-list">
              {% for item in t.beforeAfter.before.items %}
              <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </div>
          <div class="feat-card feat-card-after">
            <h3>{{ t.beforeAfter.after.title }}</h3>
            <ul class="feat-list">
              {% for item in t.beforeAfter.after.items %}
              <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
        <div class="center-cta">
          <a href="/app" class="btn-primary">{{ t.beforeAfter.ctaPrimary }}</a>
          <a href="#{{ t.features.id }}" class="btn-link">{{ t.beforeAfter.ctaSecondary }}</a>
        </div>
      </div>
    </section>

    <!-- Pocket Alternative Section -->
    <section id="{{ t.pocketAlternative.id }}" class="comparison-section" aria-labelledby="{{ t.pocketAlternative.id }}-title">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">{{ t.pocketAlternative.tag }}</span>
          <h2 id="{{ t.pocketAlternative.id }}-title">{{ t.pocketAlternative.title }}</h2>
          <p class="section-subtitle">{{ t.pocketAlternative.subtitle }}</p>
        </div>
        <div class="features-grid-3">
          {% for feature in t.pocketAlternative.features %}
          <div class="feat-card">
            <h3>{{ feature.title }}</h3>
            <p>{{ feature.text }}</p>
          </div>
          {% endfor %}
        </div>
        <div class="center-cta">
          <a href="/app" class="btn-primary">{{ t.pocketAlternative.ctaPrimary }}</a>
          <a href="{{ t.pocketAlternative.ctaSecondaryHref }}" class="btn-link">{{ t.pocketAlternative.ctaSecondary }}</a>
        </div>
      </div>
    </section>

    <!-- Raindrop Comparison Section -->
    <section id="{{ t.raindropCompare.id }}" class="raindrop-section" aria-labelledby="{{ t.raindropCompare.id }}-title">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">{{ t.raindropCompare.tag }}</span>
          <h2 id="{{ t.raindropCompare.id }}-title">{{ t.raindropCompare.title }}</h2>
          <p class="section-subtitle">{{ t.raindropCompare.subtitle }}</p>
        </div>
        <div class="rc-table" role="table" aria-label="{{ t.raindropCompare.title }}">
          <div class="rc-row rc-head" role="row">
            <div class="rc-topic" role="columnheader"></div>
            <div class="rc-us" role="columnheader">{{ t.raindropCompare.columns.us }}</div>
            <div class="rc-them" role="columnheader">{{ t.raindropCompare.columns.them }}</div>
          </div>
          {% for row in t.raindropCompare.rows %}
          <div class="rc-row" role="row">
            <div class="rc-topic" role="rowheader">{{ row.topic }}</div>
            <div class="rc-us" role="cell">{{ row.us }}</div>
            <div class="rc-them" role="cell">{{ row.them }}</div>
          </div>
          {% endfor %}
        </div>
        <p class="rc-close">{{ t.raindropCompare.close }}</p>
        <div class="center-cta">
          <a href="/app" class="btn-primary">{{ t.raindropCompare.ctaPrimary }}</a>
          <a href="/raindrop-alternative.html" class="btn-link">{{ t.raindropCompare.ctaSecondary }}</a>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section id="{{ t.features.id }}" class="features-section" aria-labelledby="{{ t.features.id }}-title">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">{{ t.features.tag }}</span>
          <h2 id="{{ t.features.id }}-title">{{ t.features.title }}</h2>
        </div>
        <div class="features-grid">
          {% for feature in t.features.items %}
          <div class="feature-item">
            <h3>{{ feature.title }}</h3>
            <p>{{ feature.text }}</p>
          </div>
          {% endfor %}
        </div>
        <p class="tier-note">
          <strong>{{ t.features.tierNote.freeLabel }}:</strong> {{ t.features.tierNote.free }}
          <span class="tier-note-sep" aria-hidden="true">·</span>
          <strong>{{ t.features.tierNote.proLabel }}:</strong> {{ t.features.tierNote.pro }}
        </p>
      </div>
    </section>

    <!-- AI Section -->
    <section id="{{ t.ai.id }}" class="ai-section" aria-labelledby="{{ t.ai.id }}-title">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">{{ t.ai.tag }}</span>
          <h2 id="{{ t.ai.id }}-title">{{ t.ai.title }}</h2>
          <p class="section-subtitle">{{ t.ai.subtitle }}</p>
        </div>

        <div class="ai-split">
          <div class="ai-column">
            <h3>{{ t.ai.providers.title }}</h3>
            <ul class="providers-list">
              {% for provider in t.ai.providers.list %}
              <li>{{ provider.name }}</li>
              {% endfor %}
            </ul>
          </div>

          <div class="ai-column">
            <h3>{{ t.ai.modes.title }}</h3>
            <div class="mode-items">
              {% for mode in t.ai.modes.items %}
              <div class="mode-item">
                <h4>{{ mode.title }}</h4>
                <p>{{ mode.text }}</p>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>

        {% if t.ai.aiTranslation %}
        <div class="ai-translation-teaser">
          <h4>{{ t.ai.aiTranslation.title }}</h4>
          <p>{{ t.ai.aiTranslation.text }}</p>
        </div>
        {% endif %}
      </div>
    </section>

    <!-- Privacy Section -->
    <section id="{{ t.privacy.id }}" class="privacy-section" aria-labelledby="{{ t.privacy.id }}-title">
      <div class="container">
        <div class="section-header">
          <h2 id="{{ t.privacy.id }}-title">{{ t.privacy.title }}</h2>
          <p class="section-subtitle">{{ t.privacy.subtitle }}</p>
        </div>
        <div class="features-grid">
          {% for item in t.privacy.items %}
          <div class="feature-item">
            <h3>{{ item.title }}</h3>
            <p>{{ item.text }}</p>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section id="{{ t.pricing.id }}" class="pricing-section" aria-labelledby="{{ t.pricing.id }}-title">
      <div class="container">
        <div class="section-header">
          <h2 id="{{ t.pricing.id }}-title">{{ t.pricing.title }}</h2>
          <p class="section-subtitle">{{ t.pricing.subtitle }}</p>
        </div>
        <div class="pricing-cards{% if t.pricing.plans.length == 3 %} three-col{% endif %}">
          {% for plan in t.pricing.plans %}
          <div class="price-card {% if plan.badge %}popular{% endif %}">
            {% if plan.badge or plan.badgeEarly %}
            <div class="price-badges">
              {% if plan.badge %}
              <span class="badge">{{ plan.badge }}</span>
              {% endif %}
              {% if plan.badgeEarly %}
              <span class="badge badge-early">{{ plan.badgeEarly }}</span>
              {% endif %}
            </div>
            {% endif %}
            <h3>{{ plan.name }}</h3>
            {% if plan.priceWas %}
            <div class="price"><span class="price-now">{{ plan.price }}</span> <span class="price-was">{{ plan.priceWas }}</span><span>{{ plan.period }}</span></div>
            {% else %}
            <div class="price">{{ plan.price }}<span>{{ plan.period }}</span></div>
            {% endif %}
            {% if plan.priceSub %}
            <div class="price-sub">{{ plan.priceSub }}</div>
            {% endif %}
            <p>{{ plan.description }}</p>
            <ul>
              {% for feature in plan.features %}
              <li><span aria-hidden="true">{{ '✅' if feature.included else '❌' }}</span> {{ feature.text }}</li>
              {% endfor %}
            </ul>
            <a href="{{ plan.ctaHref }}" class="{{ plan.ctaClass }} {% if 'btn-primary' in plan.ctaClass %}btn-block{% endif %}" {% if plan.ctaHref | startsWith('http') or plan.ctaHref | startsWith('/buy') %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ plan.cta }}</a>
            {% if plan.cta2 %}
            <a href="{{ plan.cta2Href }}" class="{{ plan.cta2Class }} btn-block" target="_blank" rel="noopener noreferrer">{{ plan.cta2 }}</a>
            {% endif %}
            {% if plan.sla %}
            <p class="sla-note">{{ plan.sla }} · <a href="{% if t.lang == 'en' %}/help#sla{% else %}/help-{{ t.lang }}#sla{% endif %}">SLA</a></p>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% if t.pricing.legal %}
        <p class="pricing-legal">{{ t.pricing.legal | safe }}</p>
        {% endif %}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section" aria-labelledby="faq-title">
      <div class="container">
        <h2 id="faq-title">{{ t.faq.title }}</h2>
        <div class="faq-grid">
          {% for item in t.faq.items %}
          <div class="faq-item">
            <h3>{{ item.question }}</h3>
            <p>{{ item.answer | safe }}</p>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="final-cta">
      <div class="container">
        <h2>{{ t.cta.title }}</h2>
        <p>{{ t.cta.text }}</p>
        <div class="ctas">
          <a href="/app" class="btn-primary">{{ t.cta.ctaPrimary }}</a>
          <a href="#{{ t.pricing.id }}" class="btn-secondary">{{ t.cta.ctaSecondary }}</a>
        </div>
        <p class="note">{{ t.cta.note }}</p>
      </div>
    </section>
  </main>

  <!-- Sticky mobile CTA: on a phone the primary button used to start below the
       fold (two pills + a long subtitle pushed it past 812px of 844px). The bar
       keeps one action always visible; landing.js hides it while the nav panel
       is open so it never covers the menu. -->
  <div class="mobile-cta-bar" id="mobileCtaBar">
    <a href="/app" class="btn-primary btn-block">{{ t.hero.ctaPrimary }}</a>
  </div>

  <footer class="footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <span>BookmarkForge</span>
        <p>{{ t.footer.brand }}</p>
      </div>
      <div class="footer-links">
        <h4>{{ t.footer.product.title }}</h4>
        <ul>
          <li><a href="/#features">{{ t.footer.product.links[0] }}</a></li>
          <li><a href="/#ai">{{ t.footer.product.links[1] }}</a></li>
          <li><a href="/#privacy">{{ t.footer.product.links[2] }}</a></li>
          <li><a href="/#pricing">{{ t.footer.product.links[3] }}</a></li>
          <li><a href="/app">{{ t.footer.product.links[4] }}</a></li>
        </ul>
      </div>
      <div class="footer-links">
        <h4>{{ t.footer.resources.title }}</h4>
        <ul>
          <li><a href="/pocket-alternative">{{ t.footer.resources.links[0] }}</a></li>
          <li><a href="/raindrop-alternative.html">Raindrop.io</a></li>
          <li><a href="/geneziz-alternative.html">Geneziz</a></li>
          <li><a href="/karakeep-alternative.html">Karakeep</a></li>
          <li><a href="/readwise-alternative.html">Readwise</a></li>
          <li><a href="/omnivore-alternative.html">Omnivore</a></li>
          <li><a href="/instapaper-alternative.html">Instapaper</a></li>
          <li><a href="/privacy-and-terms.html">{{ t.footer.resources.links[1] }}</a></li>
        </ul>
      </div>
      <div class="footer-links">
        <h4>{{ t.footer.support.title }}</h4>
        <ul>
          <li><a href="{% if t.lang == 'en' %}/help{% else %}/help-{{ t.lang }}{% endif %}">{{ t.footer.support.helpCenter | default('Help Center') }}</a></li>
          <li><a href="{% if t.lang == 'en' %}/help#sla{% else %}/help-{{ t.lang }}#sla{% endif %}">SLA</a></li>
          <li><a href="{% if t.lang == 'en' %}/help#bf-e{% else %}/help-{{ t.lang }}#bf-e{% endif %}">{{ t.footer.support.errorCodes | default('Error Codes') }}</a></li>
          {% for link in t.footer.support.links %}
          <li><a href="mailto:bookmarkforge@proton.me">{{ link }}</a></li>
          {% endfor %}
        </ul>
        <p class="footer-hours">{{ t.footer.support.hours }}</p>
      </div>
    </div>
    <!-- EN is the root landing: its legal page lives at /privacy-and-terms.html.
         The six reviewed legal locales (en, es, fr, de, pt, it — LEGAL_LOCALE_CODES
         in scripts/landing-registry.mjs) keep their own notice under /<lang>/;
         the other 24 have no legal page, so their footer points at the English
         notice directly instead of a URL that only answers through a 301. -->
    <div class="footer-bottom">
      <p>{{ t.footer.copyright }}</p>
      {% if t.lang == "en" %}
        {% set legalHref = "/privacy-and-terms.html" %}
      {% elif t.lang in ["es", "fr", "de", "pt", "it"] %}
        {% set legalHref = "/" + t.lang + "/privacy-and-terms.html" %}
      {% else %}
        {% set legalHref = "/privacy-and-terms.html" %}
      {% endif %}
      <a href="{{ legalHref }}">{{ t.footer.legal[0] }}</a> · <a href="{{ legalHref }}#terms">{{ t.footer.legal[1] }}</a> · <a href="mailto:bookmarkforge@proton.me">{{ t.footer.legal[2] }}</a>
      <span class="github-star">
        <a href="https://github.com/bookmarkforge/bookmarkforge-core" target="_blank" rel="noopener noreferrer" aria-label="{{ t.githubAria }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
