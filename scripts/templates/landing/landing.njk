<!DOCTYPE html>
<html lang="{{ t.lang }}"
  dir="{{ t.dir }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#00aeef" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)">
  <meta name="description" content="{{ t.description }}">
  <title>{{ t.title }}</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <!-- SEO: canonical + hreflang -->
  <link rel="canonical" href="{{ t.canonical }}">
  <link rel="alternate" hreflang="ar" href="https://bookmarkforgeapp.com/ar/">
  <link rel="alternate" hreflang="bg" href="https://bookmarkforgeapp.com/bg/">
  <link rel="alternate" hreflang="cs" href="https://bookmarkforgeapp.com/cs/">
  <link rel="alternate" hreflang="da" href="https://bookmarkforgeapp.com/da/">
  <link rel="alternate" hreflang="de" href="https://bookmarkforgeapp.com/de/">
  <link rel="alternate" hreflang="el" href="https://bookmarkforgeapp.com/el/">
  <link rel="alternate" hreflang="en" href="https://bookmarkforgeapp.com/">
  <link rel="alternate" hreflang="es" href="https://bookmarkforgeapp.com/es/">
  <link rel="alternate" hreflang="fi" href="https://bookmarkforgeapp.com/fi/">
  <link rel="alternate" hreflang="fr" href="https://bookmarkforgeapp.com/fr/">
  <link rel="alternate" hreflang="he" href="https://bookmarkforgeapp.com/he/">
  <link rel="alternate" hreflang="hi" href="https://bookmarkforgeapp.com/hi/">
  <link rel="alternate" hreflang="hr" href="https://bookmarkforgeapp.com/hr/">
  <link rel="alternate" hreflang="hu" href="https://bookmarkforgeapp.com/hu/">
  <link rel="alternate" hreflang="id" href="https://bookmarkforgeapp.com/id/">
  <link rel="alternate" hreflang="it" href="https://bookmarkforgeapp.com/it/">
  <link rel="alternate" hreflang="ja" href="https://bookmarkforgeapp.com/ja/">
  <link rel="alternate" hreflang="ko" href="https://bookmarkforgeapp.com/ko/">
  <link rel="alternate" hreflang="nl" href="https://bookmarkforgeapp.com/nl/">
  <link rel="alternate" hreflang="no" href="https://bookmarkforgeapp.com/no/">
  <link rel="alternate" hreflang="pl" href="https://bookmarkforgeapp.com/pl/">
  <link rel="alternate" hreflang="pt" href="https://bookmarkforgeapp.com/pt/">
  <link rel="alternate" hreflang="ro" href="https://bookmarkforgeapp.com/ro/">
  <link rel="alternate" hreflang="ru" href="https://bookmarkforgeapp.com/ru/">
  <link rel="alternate" hreflang="sv" href="https://bookmarkforgeapp.com/sv/">
  <link rel="alternate" hreflang="th" href="https://bookmarkforgeapp.com/th/">
  <link rel="alternate" hreflang="tr" href="https://bookmarkforgeapp.com/tr/">
  <link rel="alternate" hreflang="uk" href="https://bookmarkforgeapp.com/uk/">
  <link rel="alternate" hreflang="vi" href="https://bookmarkforgeapp.com/vi/">
  <link rel="alternate" hreflang="zh" href="https://bookmarkforgeapp.com/zh/">
  <link rel="alternate" hreflang="x-default" href="https://bookmarkforgeapp.com/">
  <!-- Open Graph (og-image.png is 1200x630) -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="BookmarkForge">
  <meta property="og:title" content="{{ t.ogTitle }}">
  <meta property="og:description" content="{{ t.ogDescription }}">
  <meta property="og:url" content="{{ t.canonical }}">
  <meta property="og:image" content="{{ t.ogImage }}">
  <meta property="og:image:alt" content="BookmarkForge — private AI-powered bookmark and notes app">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="{{ t.ogLocale }}">
  <meta property="og:locale:alternate" content="{{ t.ogLocaleAlternate }}">
  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ t.twitterTitle }}">
  <meta name="twitter:description" content="{{ t.twitterDescription }}">
  <meta name="twitter:image" content="{{ t.twitterImage }}">
  <link rel="stylesheet" href="/brand-tokens.css">
  <link rel="stylesheet" href="/landing.css">
  <!-- Structured data: WebSite / Organization / SoftwareApplication / FAQPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ t.canonical }}#website",
        "url": "{{ t.canonical }}",
        "name": "{{ t.structuredData.websiteName }}",
        "description": "{{ t.structuredData.websiteDescription }}",
        "inLanguage": "{{ t.lang }}",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "{{ t.canonical }}?s={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        },
        "publisher": { "@id": "https://bookmarkforgeapp.com/#organization" }
      },
      {
        "@type": "Organization",
        "@id": "https://bookmarkforgeapp.com/#organization",
        "name": "{{ t.structuredData.organizationName }}",
        "url": "{{ t.structuredData.organizationUrl }}",
        "logo": { "@type": "ImageObject", "url": "https://bookmarkforgeapp.com/logo.png", "width": 64, "height": 64 },
        "email": "{{ t.structuredData.organizationEmail }}"
      },
      {
        "@type": "SoftwareApplication",
        "@id": "{{ t.canonical }}#software",
        "name": "{{ t.structuredData.softwareName }}",
        "applicationCategory": "{{ t.structuredData.softwareCategory }}",
        "operatingSystem": "{{ t.structuredData.softwareOs }}",
        "url": "{{ t.structuredData.softwareUrl }}",
        "image": "{{ t.ogImage }}",
        "description": "{{ t.description }}",
        "offers": [
          {% for offer in t.structuredData.offers %}
          { "@type": "Offer", "name": "{{ offer.name | escapejs }}", "price": "{{ offer.price }}", "priceCurrency": "{{ offer.currency }}"{% if offer.description %}, "description": "{{ offer.description | escapejs }}"{% endif %}{% if offer.priceValidUntil %}, "priceValidUntil": "{{ offer.priceValidUntil }}"{% endif %}{% if offer.availability %}, "availability": "{{ offer.availability }}"{% endif %} }{% if not loop.last %},{% endif %}
          {% endfor %}
        ],
        "featureList": [
          {% for feature in t.structuredData.featureList %}
          "{{ feature }}"{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      },
      {
        "@type": "FAQPage",
        "@id": "{{ t.canonical }}#faq",
        "mainEntity": [
          {% for faq in t.structuredData.faq %}
          {
            "@type": "Question",
            "name": "{{ faq.question | escapejs }}",
            "acceptedAnswer": { "@type": "Answer", "text": "{{ faq.answer | escapejs }}" }
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }
    ]
  }
  </script>
</head>
<body>
  <a href="#main" class="skip-link">{{ t.skipLink }}</a>

  <header class="nav" role="banner">
    <div class="nav-inner">
      <a href="{{ t.homeHref }}" class="nav-brand" aria-label="{{ t.navBrandAria }}">
        <img src="/logo-64.png" width="32" height="32" alt="" />
        <span>BookmarkForge</span>
      </a>

      <nav class="nav-links" aria-label="{{ t.navAriaLabel }}">
        <a href="#{{ t.pocketAlternative.id }}">{{ t.pocketAlternative.tag }}</a>
        {% if t.raindropCompare %}<a href="#{{ t.raindropCompare.id }}">{{ t.navLinks.raindropCompare }}</a>{% endif %}
        <a href="#{{ t.features.id }}">{{ t.navLinks.features }}</a>
        <a href="#{{ t.ai.id }}">{{ t.navLinks.ai }}</a>
        <a href="#{{ t.privacy.id }}">{{ t.navLinks.privacy }}</a>
        <a href="#{{ t.pricing.id }}">{{ t.navLinks.pricing }}</a>
        <a href="/help">{{ t.navLinks.help | default('Help') }}</a>
        
        <!-- Language Dropdown -->
        <div class="language-dropdown">
          <button class="language-toggle" aria-label="Select language" aria-expanded="false">
            <span class="current-lang">{{ t.langName }}</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 4 L6 8 L10 4"/>
            </svg>
          </button>
          <ul class="language-menu" role="menu">
            {% for lang in languageLinks %}
            <li role="none">
              <a href="{{ lang.href }}" hreflang="{{ lang.hreflang }}" lang="{{ lang.lang }}" role="menuitem"{% if lang.code == t.lang %} class="current"{% endif %}>
                {{ lang.name }}
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>
        
        <a href="/app" class="btn-primary nav-cta">{{ t.navCta }}</a>
      </nav>

      <button class="theme-toggle" id="themeToggle" aria-label="{{ t.themeToggleAria }}" aria-pressed="false">
        <svg class="theme-icon-light" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        <svg class="theme-icon-dark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container">
        <div class="hero-content">
          <span class="hero-badge">{{ t.hero.badge }}</span>
          <h1 id="hero-title">{{ t.hero.title | safe }}</h1>
          <p class="hero-subtitle">{{ t.hero.subtitle }}</p>
          <div class="hero-ctas">
            <a href="/app" class="btn-primary">{{ t.hero.ctaPrimary }}</a>
            <a href="#{{ t.pricing.id }}" class="btn-secondary">{{ t.hero.ctaSecondary }}</a>
          </div>
          <div class="hero-pillars">
            {% for pillar in t.hero.pillars %}
            <span><strong>{{ pillar.strong }}</strong> — {{ pillar.text }}</span>
            {% endfor %}
          </div>
          {% if t.hero.affiliate %}
          <div class="hero-affiliate">
            <span class="hero-affiliate-badge">{{ t.hero.affiliate.badge }}</span>
            <h3 class="hero-affiliate-title">{{ t.hero.affiliate.title }}</h3>
            <p class="hero-affiliate-subtitle">{{ t.hero.affiliate.subtitle }}</p>
            <a href="https://whop.com/affiliates" class="btn-small">{{ t.hero.affiliate.cta }}</a>
            <ul class="hero-affiliate-details">
              {% for detail in t.hero.affiliate.details %}
              <li>{{ detail }}</li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}
        </div>
      </div>
    </section>

    <!-- Product Demo Section — steps and CTA only. The tour GIF this section
         used to show was retired with the demo-media pipeline; the template kept
         a dead <img> pointing at it until the ADR-062 smoke gate reported the 404
         on all 30 landings. The demo.* copy still describes the loop: rewriting it
         has to come with the translations, not from the template.
         Secondary locales carry demo: null until that copy is translated —
         the section is hidden rather than rendering English inside a
         localized page (same for raindropCompare below). -->
    {% if t.demo %}
    <section id="{{ t.demo.id }}" class="demo-tour" aria-labelledby="{{ t.demo.id }}-title">
      <div class="container">
        <div class="demo-tour-header">
          <span class="demo-tour-tag">{{ t.demo.tag }}</span>
          <h2 id="{{ t.demo.id }}-title" class="demo-tour-title">{{ t.demo.title }}</h2>
          <p class="demo-tour-subtitle">{{ t.demo.subtitle }}</p>
        </div>
        <ol class="demo-tour-steps">
          {% for step in t.demo.steps %}
          <li class="demo-tour-step">
            <strong class="demo-tour-step-title">{{ step.title }}</strong>
            <span class="demo-tour-step-text">{{ step.text }}</span>
          </li>
          {% endfor %}
        </ol>
        <div class="demo-tour-cta">
          <a href="/app" class="btn-primary">{{ t.demo.ctaPrimary }}</a>
        </div>
      </div>
    </section>
    {% endif %}

    <!-- Pocket Alternative Section -->
    <section id="{{ t.pocketAlternative.id }}" class="comparison-section" aria-labelledby="{{ t.pocketAlternative.id }}-title">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">{{ t.pocketAlternative.tag }}</span>
          <h2 id="{{ t.pocketAlternative.id }}-title">{{ t.pocketAlternative.title }}</h2>
          <p class="section-subtitle">{{ t.pocketAlternative.subtitle }}</p>
        </div>
        <div class="features-grid-3">
          {% for feature in t.pocketAlternative.features %}
          <div class="feat-card">
            <h3>{{ feature.title }}</h3>
            <p>{{ feature.text }}</p>
          </div>
          {% endfor %}
        </div>
        <div class="center-cta">
          <a href="/app" class="btn-primary">{{ t.pocketAlternative.ctaPrimary }}</a>
          <a href="{{ t.pocketAlternative.ctaSecondaryHref }}" class="btn-link">{{ t.pocketAlternative.ctaSecondary }}</a>
        </div>
      </div>
    </section>

    <!-- Raindrop Comparison Section (hidden while raindropCompare is null) -->
    {% if t.raindropCompare %}
    <section id="{{ t.raindropCompare.id }}" class="raindrop-section" aria-labelledby="{{ t.raindropCompare.id }}-title">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">{{ t.raindropCompare.tag }}</span>
          <h2 id="{{ t.raindropCompare.id }}-title">{{ t.raindropCompare.title }}</h2>
          <p class="section-subtitle">{{ t.raindropCompare.subtitle }}</p>
        </div>
        <div class="rc-table" role="table" aria-label="{{ t.raindropCompare.title }}">
          <div class="rc-row rc-head" role="row">
            <div class="rc-topic" role="columnheader"></div>
            <div class="rc-us" role="columnheader">{{ t.raindropCompare.columns.us }}</div>
            <div class="rc-them" role="columnheader">{{ t.raindropCompare.columns.them }}</div>
          </div>
          {% for row in t.raindropCompare.rows %}
          <div class="rc-row" role="row">
            <div class="rc-topic" role="rowheader">{{ row.topic }}</div>
            <div class="rc-us" role="cell">{{ row.us }}</div>
            <div class="rc-them" role="cell">{{ row.them }}</div>
          </div>
          {% endfor %}
        </div>
        <p class="rc-close">{{ t.raindropCompare.close }}</p>
        <div class="center-cta">
          <a href="/app" class="btn-primary">{{ t.raindropCompare.ctaPrimary }}</a>
          <a href="{{ t.pocketAlternative.ctaSecondaryHref }}" class="btn-link">{{ t.raindropCompare.ctaSecondary }}</a>
        </div>
      </div>
    </section>
    {% endif %}

    <!-- Features Section -->
    <section id="{{ t.features.id }}" class="features-section" aria-labelledby="{{ t.features.id }}-title">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">{{ t.features.tag }}</span>
          <h2 id="{{ t.features.id }}-title">{{ t.features.title }}</h2>
        </div>
        <div class="features-grid">
          {% for feature in t.features.items %}
          <div class="feature-item">
            <h3>{{ feature.title }}</h3>
            <p>{{ feature.text }}</p>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- AI Section -->
    <section id="{{ t.ai.id }}" class="ai-section" aria-labelledby="{{ t.ai.id }}-title">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">{{ t.ai.tag }}</span>
          <h2 id="{{ t.ai.id }}-title">{{ t.ai.title }}</h2>
          <p class="section-subtitle">{{ t.ai.subtitle }}</p>
        </div>

        <div class="ai-split">
          <div class="ai-column">
            <h3>{{ t.ai.providers.title }}</h3>
            <ul class="providers-list">
              {% for provider in t.ai.providers.list %}
              <li>{{ provider.name }}</li>
              {% endfor %}
            </ul>
          </div>

          <div class="ai-column">
            <h3>{{ t.ai.modes.title }}</h3>
            <div class="mode-items">
              {% for mode in t.ai.modes.items %}
              <div class="mode-item">
                <h4>{{ mode.title }}</h4>
                <p>{{ mode.text }}</p>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy Section -->
    <section id="{{ t.privacy.id }}" class="privacy-section" aria-labelledby="{{ t.privacy.id }}-title">
      <div class="container">
        <div class="section-header">
          <h2 id="{{ t.privacy.id }}-title">{{ t.privacy.title }}</h2>
          <p class="section-subtitle">{{ t.privacy.subtitle }}</p>
        </div>
        <div class="features-grid">
          {% for item in t.privacy.items %}
          <div class="feature-item">
            <h3>{{ item.title }}</h3>
            <p>{{ item.text }}</p>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section id="{{ t.pricing.id }}" class="pricing-section" aria-labelledby="{{ t.pricing.id }}-title">
      <div class="container">
        <div class="section-header">
          <h2 id="{{ t.pricing.id }}-title">{{ t.pricing.title }}</h2>
          <p class="section-subtitle">{{ t.pricing.subtitle }}</p>
        </div>
        <div class="pricing-cards{% if t.pricing.plans.length == 3 %} three-col{% endif %}">
          {% for plan in t.pricing.plans %}
          <div class="price-card {% if plan.badge %}popular{% endif %}">
            {% if plan.badge %}
            <span class="badge">{{ plan.badge }}</span>
            {% endif %}
            {% if plan.badgeEarly %}
            <span class="badge badge-early">{{ plan.badgeEarly }}</span>
            {% endif %}
            <h3>{{ plan.name }}</h3>
            {% if plan.priceWas %}
            <div class="price"><span class="price-now">{{ plan.price }}</span> <span class="price-was">{{ plan.priceWas }}</span><span>{{ plan.period }}</span></div>
            {% else %}
            <div class="price">{{ plan.price }}<span>{{ plan.period }}</span></div>
            {% endif %}
            {% if plan.priceSub %}
            <div class="price-sub">{{ plan.priceSub }}</div>
            {% endif %}
            <p>{{ plan.description }}</p>
            <ul>
              {% for feature in plan.features %}
              <li><span aria-hidden="true">{{ '✅' if feature.included else '❌' }}</span> {{ feature.text }}</li>
              {% endfor %}
            </ul>
            <a href="{{ plan.ctaHref }}" class="{{ plan.ctaClass }} {% if 'btn-primary' in plan.ctaClass %}btn-block{% endif %}" {% if plan.ctaHref | startsWith('http') or plan.ctaHref | startsWith('/buy') %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ plan.cta }}</a>
            {% if plan.sla %}
            <p class="sla-note">{{ plan.sla }} · <a href="/help#sla">SLA</a></p>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% if t.pricing.legal %}
        <p class="pricing-legal">{{ t.pricing.legal | safe }}</p>
        {% endif %}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section" aria-labelledby="faq-title">
      <div class="container">
        <h2 id="faq-title">{{ t.faq.title }}</h2>
        <div class="faq-grid">
          {% for item in t.faq.items %}
          <div class="faq-item">
            <h3>{{ item.question }}</h3>
            <p>{{ item.answer | safe }}</p>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="final-cta">
      <div class="container">
        <h2>{{ t.cta.title }}</h2>
        <p>{{ t.cta.text }}</p>
        <div class="ctas">
          <a href="/app" class="btn-primary">{{ t.cta.ctaPrimary }}</a>
          <a href="#{{ t.pricing.id }}" class="btn-secondary">{{ t.cta.ctaSecondary }}</a>
        </div>
        <p class="note">{{ t.cta.note }}</p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <span>BookmarkForge</span>
        <p>{{ t.footer.brand }}</p>
      </div>
      <div class="footer-links">
        <h4>{{ t.footer.product.title }}</h4>
        <ul>
          <li><a href="#{{ t.features.id }}">{{ t.footer.product.links[0] }}</a></li>
          <li><a href="#{{ t.ai.id }}">{{ t.footer.product.links[1] }}</a></li>
          <li><a href="#{{ t.privacy.id }}">{{ t.footer.product.links[2] }}</a></li>
          <li><a href="#{{ t.pricing.id }}">{{ t.footer.product.links[3] }}</a></li>
          <li><a href="/app">{{ t.footer.product.links[4] }}</a></li>
        </ul>
      </div>
      <div class="footer-links">
        <h4>{{ t.footer.resources.title }}</h4>
        <ul>
          <li><a href="/pocket-alternative">{{ t.footer.resources.links[0] }}</a></li>
          <li><a href="/privacy-and-terms.html">{{ t.footer.resources.links[1] }}</a></li>
        </ul>
      </div>
      <div class="footer-links">
        <h4>{{ t.footer.languages.title }}</h4>
        <ul>
          {% for lang in languageLinks %}
          <li><a href="{{ lang.href }}" hreflang="{{ lang.hreflang }}" lang="{{ lang.lang }}">{{ lang.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div class="footer-links">
        <h4>{{ t.footer.support.title }}</h4>
        <ul>
          <li><a href="/help">{{ t.footer.support.helpCenter | default('Help Center') }}</a></li>
          <li><a href="/help#sla">SLA</a></li>
          <li><a href="/help#bf-e">{{ t.footer.support.errorCodes | default('Error Codes') }}</a></li>
          {% for link in t.footer.support.links %}
          <li><a href="mailto:bookmarkforge@proton.me">{{ link }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <!-- EN is the root landing: its legal page lives at /privacy-and-terms.html.
         Every other locale has its own directory. The rule has one owner —
         scripts/landing-registry.mjs (LEGAL_LOCALE_CODES), already encoded by
         check-seo, check-sitemap-coverage, check-hreflang-graph and
         check-page-figures. Emitting "/{{ t.lang }}/…" unconditionally shipped a
         404 footer link on every EN landing until the ADR-062 smoke gate opened it. -->
    <div class="footer-bottom">
      <p>{{ t.footer.copyright }}</p>
      {% set legalHref = "/privacy-and-terms.html" if t.lang == "en" else "/" + t.lang + "/privacy-and-terms.html" %}
      <a href="{{ legalHref }}">{{ t.footer.legal[0] }}</a> · <a href="{{ legalHref }}#terms">{{ t.footer.legal[1] }}</a> · <a href="mailto:bookmarkforge@proton.me">{{ t.footer.legal[2] }}</a>
    </div>
  </footer>

  <script src="/landing.js" defer></script>
</body>
</html>