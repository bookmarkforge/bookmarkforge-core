# Vercel Domain Configuration Script Environment Variables
# Copy this file to .env.local and fill in your values

# Your Vercel API token
# Get it from: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token_here

# Your Vercel project ID
# Find it in Vercel project settings under "General"
VERCEL_PROJECT_ID=your_project_id_here

# Domain to configure (optional, defaults to www.bookmarkforgeapp.com)
DOMAIN=www.bookmarkforgeapp.com

# Target environment (optional, defaults to production)
ENVIRONMENT=production
