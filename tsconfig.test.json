{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Test-tree strictness: noUncheckedIndexedAccess is enforced (matches
    // prod), but noUnusedLocals/Parameters stay false — test files
    // legitimately import symbols for their side effects (vi.mock
    // hoisting, RxDB plugin registration) and use underscore-prefixed
    // params in matchers. ESLint's no-unused-vars rule covers tests at
    // lint time; the compiler gate here is about TYPE safety, not
    // dead-code detection.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Tests may use `any` for mocks and dynamic DB access; the
    // no-explicit-any ESLint rule is configured off for test files.
    "noImplicitAny": true
  },
  "include": [
    "src",
    "tests",
    "server",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.human-like.config.ts",
    "playwright.performance.config.ts",
    "playwright.public-relay.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-extension",
    "extension",
    // src/tests/db/encryption.test.ts: dynamic collection accesses on
    // RxDatabase (db.secrets, db.close()) — rxdb ships strict types
    // without an index signature. Fixed below with explicit casts.
    "src/tests/db/encryption.test.ts",
    // These 3 tests import Pro modules (FlashcardService, GlobalRAGService,
    // SpecializedAgentsService) which have no type declarations in the
    // dev tree. They run under vitest/esbuild only; tsc can't resolve
    // the types. See docs/ADR-###-pro-test-types for the resolution path.
    "src/tests/services/ai/FlashcardService.test.ts",
    "src/tests/services/ai/GlobalRAGService.test.ts",
    "src/tests/services/ai/SpecializedAgentsService.test.ts"
  ]
}