  "redirects": [
    {
      "source": "/buy-pro",
      "destination": "https://whop.com/checkout/plan_XU1GaWhoYhoDh",
      "statusCode": 302
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "bf_lang",
          "value": "^(?<lang>ar|bg|cs|da|de|el|es|fi|fr|he|hi|hr|hu|id|it|ja|ko|nl|no|pl|pt|ro|ru|sv|th|tr|uk|vi|zh)$"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "lang",
          "value": "^(en|ar|bg|cs|da|de|el|es|fi|fr|he|hi|hr|hu|id|it|ja|ko|nl|no|pl|pt|ro|ru|sv|th|tr|uk|vi|zh)$"
        }
      ],
      "destination": "/:lang/",
      "statusCode": 302
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^(?<lang>ar|bg|cs|da|de|el|es|fi|fr|he|hi|hr|hu|id|it|ja|ko|nl|no|pl|pt|ro|ru|sv|th|tr|uk|vi|zh)([-,;].*)?$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "bf_lang"
        },
        {
          "type": "query",
          "key": "lang",
          "value": "^(en|ar|bg|cs|da|de|el|es|fi|fr|he|hi|hr|hu|id|it|ja|ko|nl|no|pl|pt|ro|ru|sv|th|tr|uk|vi|zh)$"
        }
      ],
      "destination": "/:lang/",
      "statusCode": 302
    }
  ],
  "env": {
    "VITE_BUILD_ENV": "production"
  }
}
